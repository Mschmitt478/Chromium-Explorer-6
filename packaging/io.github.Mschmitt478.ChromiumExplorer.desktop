[Desktop Entry]
Type=Application
Name=Internet Explorer XP
GenericName=Web Browser
Comment=Browse the web with a classic desktop interface
Exec=iexplore %u
Icon=io.github.Mschmitt478.ChromiumExplorer
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
Actions=Private;

[Desktop Action Private]
Name=New Private Window
Exec=iexplore --private
